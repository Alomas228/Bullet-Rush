  enemySpawnRadius: 8
  mobsFastCount: 1
  mobsRangedCount: 1
  markerOnMobsStep: 1
  pauseBetweenSteps: 0.6
  dodgeSpawnRange: 10
  dodgeMoveDistance: 1.5
  dodgeRespawnInterval: 6
  markerOnDodgeStep: 1
  stepCompleteSound: 1
  killOneText: "\u0423\u0411\u0415\u0419 \u0415\u0413\u041E!"
  mobsStepText: "\u0411\u042B\u0421\u0422\u0420\u042B\u0415 \u041D\u0410\u0411\u0415\u0413\u0410\u042E\u0422,
    \u0421\u0422\u0420\u0415\u041B\u041A\u0418 \u0411\u042C\u042E\u0422 \u0418\u0417\u0414\u0410\u041B\u0415\u041A\u0410.\n\u041D\u0415
    \u0421\u0422\u041E\u0419 \u041D\u0410 \u041C\u0415\u0421\u0422\u0415!"
  dodgeText: "\u0423\u041A\u041B\u041E\u041D\u042F\u0419\u0421\u042F \u041E\u0422
    \u0421\u041D\u0410\u0420\u042F\u0414\u041E\u0412!"
  upgradeHintText: "\u0422\u0415\u041F\u0415\u0420\u042C \u0412\u042B\u0411\u0415\u0420\u0418
    \u041E\u0414\u041D\u041E \u0423\u041B\u0423\u0427\u0428\u0415\u041D\u0418\u0415
    \u2014 \u041E\u041D\u041E \u0423\u0421\u0418\u041B\u0418\u0422 \u0422\u0415\u0411\u042F
    \u0412 \u042D\u0422\u041E\u041C \u0417\u0410\u0411\u0415\u0413\u0415.\n\u0426\u0412\u0415\u0422
    \u041D\u0410\u0417\u0412\u0410\u041D\u0418\u042F = \u0420\u0415\u0414\u041A\u041E\u0421\u0422\u042C:\n\u0421\u0415\u0420\u042B\u0419
    \u2014 \u041E\u0411\u042B\u0427\u041D\u041E\u0415 \xB7 \u0417\u0415\u041B\u0401\u041D\u042B\u0419
    \u2014 \u041D\u0415\u041E\u0411\u042B\u0427\u041D\u041E\u0415 \xB7 \u0421\u0418\u041D\u0418\u0419
    \u2014 \u0420\u0415\u0414\u041A\u041E\u0415\n\u0424\u0418\u041E\u041B\u0415\u0422\u041E\u0412\u042B\u0419
    \u2014 \u042D\u041F\u0418\u0427\u0415\u0421\u041A\u041E\u0415 \xB7 \u041E\u0420\u0410\u041D\u0416\u0415\u0412\u042B\u0419
    \u2014 \u041B\u0415\u0413\u0415\u041D\u0414\u0410\u0420\u041D\u041E\u0415"
